<?xml version="1.0" encoding="utf-8"?>
<!-- Excludes raw SMS / financial DB from auto backup and device transfer (privacy requirement). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
